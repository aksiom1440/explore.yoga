# GoHighLevel (Ancient Science OÜ). Private Integration in that sub-account.
GHL_API_KEY=
GHL_LOCATION_ID=

# Kit (kit.com)
KIT_API_KEY=
KIT_FORM_ID=

# ConvertKit (legacy)
CONVERTKIT_API_KEY=
